\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Validity conditions at random initialization ($D=2$, $L=5$, $\epsilon =0.1$, double precision). Volume preservation is $\max |{\det \nabla T}|-1$; involutivity is $\max \|(RT)^2 z - z\|_\infty $.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:validity}{{2}{5}{Validity conditions at random initialization ($D=2$, $L=5$, $\epsilon =0.1$, double precision). Volume preservation is $\max |{\det \nabla T}|-1$; involutivity is $\max \|(\flip T)^2 z - z\|_\infty $}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces (a) Gaussian-process hyperparameter inference at the configuration of \citet  {Li_2019} ($n=500$, Mat\'ern $\nu =3/2$, $\epsilon =0.05$, $L=20$, $10^4$ samples); best value over training budgets. The symmetrized flow map attains $3.7\times $ the ESS/s of exact HMC, while every integrator-based surrogate is slower than exact HMC. The unsymmetrized network (hatched) posts a competitive number at a reversibility error of $5\times 10^{-4}$ and is not a valid sampler. (b) ESS/s against trajectory length. The flow map's advantage grows with $L$; the integrator-based surrogate collapses because it compounds error over $L$ steps; and training on $\mathcal  {O}(L^2)$ pairs erases the gain.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:results}{{1}{5}{(a) Gaussian-process hyperparameter inference at the configuration of \citet {Li_2019} ($n=500$, Mat\'ern $\nu =3/2$, $\epsilon =0.05$, $L=20$, $10^4$ samples); best value over training budgets. The symmetrized flow map attains $3.7\times $ the ESS/s of exact HMC, while every integrator-based surrogate is slower than exact HMC. The unsymmetrized network (hatched) posts a competitive number at a reversibility error of $5\times 10^{-4}$ and is not a valid sampler. (b) ESS/s against trajectory length. The flow map's advantage grows with $L$; the integrator-based surrogate collapses because it compounds error over $L$ steps; and training on $\mathcal {O}(L^2)$ pairs erases the gain}{figure.1}{}}
